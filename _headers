# Cloudflare static-asset headers (wrangler.jsonc). Ignored by GitHub Pages,
# Electron and the Android app, which just carry this file along unused.

# Vite fingerprints everything in /assets, so it can be cached for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
